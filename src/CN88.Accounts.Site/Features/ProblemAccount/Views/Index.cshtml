@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    ViewBag.Title = Resources.ProblemAccount;
}
@section Styles{
    @StaticResources.RenderStyles("~/Features/ProblemAccount/bundles/index")
}
@using CN88.Common.Models
@model CN88.Accounts.Site.Features.ProblemAccount.ViewModels.IndexViewModel
@if (!Model.IsMobile)
{
    <div class="note">
        <span class="start">*</span>@Resources.ProblemAccountNote
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel" data-toggle="tooltip" data-placement="bottom"></span>
    </div>
}
<ul id="nav-tabs" class="nav @(Model.IsMobile ? "nav-tabs" : "nav-tabs-style2")" role="tablist">
    <li class="@(Model.CustLevel.IsMasterLevel() ? "active" : string.Empty)" role="presentation">
        <a href="@Url.Action("Index", "ProblemAccount", new { CustLevelId = UserLevel.Master.Value })">@Resources.Master</a>
    </li>
    <li class="@(Model.CustLevel.IsAgentLevel() ? "active" : string.Empty)" role="presentation">
        <a href="@Url.Action("Index", "ProblemAccount", new { CustLevelId = UserLevel.Agent.Value })">@Resources.Agent</a>
    </li>
    <li class="@(Model.CustLevel.IsMemberLevel() ? "active" : string.Empty)" role="presentation">
        <a href="@Url.Action("Index", "ProblemAccount", new { CustLevelId = UserLevel.Member.Value })">@Resources.Member</a>
    </li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade in active" role="tabpanel">
        <div class="tab-header">
            <span class="icon-filter-down" id="filter-toggle-icon"></span>
        </div>
        @Html.Partial("_Filter", Model.FilterViewModel)
        @Html.Partial("_ProblemAccountTable")
        @Pager.Render(Model.PagerViewModel)
    </div>
</div>
@Html.Hidden(nameof(Resources.UpdateStatus), Resources.UpdateStatus)
@Html.Hidden(nameof(Resources.SetReviewedStatus), Resources.SetReviewedStatus)
@Html.Hidden(nameof(Resources.OK), Resources.OK)
@Html.Hidden(nameof(Resources.SystemMessage), Resources.SystemMessage)
@Html.Hidden(nameof(Resources.SetToReviewedValidationMessage), Resources.SetToReviewedValidationMessage)
@Html.Hidden("UpdateReviewStatusUrl", Url.Action("UpdateReviewStatus", "ProblemAccount"))
@section Scripts{
    @StaticResources.RenderScripts("~/Features/ProblemAccount/bundles/index")
}
