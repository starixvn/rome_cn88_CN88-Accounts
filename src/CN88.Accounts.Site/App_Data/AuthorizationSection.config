<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[B],[D],[E],[H]"
  custIdQueryStringParamNameMapping="custid"
  custIdJsonParamNameMapping=""
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [B]: Account Management Edit & View
    [D]: Total Bets
    [E]: Reports
    [H]: Account Management View Only
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <DeniedPages>
      <add url="ProblemAccount/Index" />
      <add url="ProblemAccount/UpdateReviewStatus" />
    </DeniedPages>
    <PageAccesses>
      <add id="1.01.01" permission="[H]" mainfuncname="Problem Account" subfuncname="Problem Account" url="ProblemAccount/Index" ischeckbelonging="true" />
      <add id="1.01.02" permission="[B]" mainfuncname="Problem Account" subfuncname="Update Review Status" url="ProblemAccount/UpdateReviewStatus" ischeckbelonging="true" />

      <add id="1.02.01" permission="[Z]" mainfuncname="Sub Account" subfuncname="List" url="SubAccount/Index" ischeckbelonging="false" ischeckaccountstatus="true" />
      <add id="1.02.02" permission="[Z]" mainfuncname="Sub Account" subfuncname="New" url="SubAccount/New" ischeckbelonging="false" ischeckaccountstatus="true" />
      <add id="1.02.03" permission="[Z]" mainfuncname="Sub Account" subfuncname="Edit" url="SubAccount/Edit" ischeckbelonging="false" ischeckaccountstatus="true" />
      <add id="1.02.04" permission="[Z]" mainfuncname="Sub Account" subfuncname="Unlock" url="SubAccount/Unlock" ischeckbelonging="false" ischeckaccountstatus="true" />
      <add id="1.02.05" permission="[Z]" mainfuncname="Sub Account" subfuncname="Delete" url="SubAccount/Delete" ischeckbelonging="false" ischeckaccountstatus="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <DeniedPages>
      <add url="ProblemAccount/Index" />
      <add url="ProblemAccount/UpdateReviewStatus" />
    </DeniedPages>
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>