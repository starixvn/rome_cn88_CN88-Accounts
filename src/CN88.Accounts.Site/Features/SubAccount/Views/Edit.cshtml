@using Sunplus.Agent.Model.Entities;
@using CN88.Accounts.Site.Features.SubAccount.ViewModels
@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    ViewBag.Title = Resources.SubAccount;
}
@section Styles {
    @StaticResources.RenderStyles("~/Features/SubAccount/bundles/sub-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/Features/SubAccount/bundles/edit-sub-account")
}
@model EditViewModel
<div class="modal-sub-account">
    <div id="message-container" class="message-container"></div>
    @using (Html.BeginForm("Edit", "SubAccount", FormMethod.Post, new { id = "formSubAccount", @class = "form-horizontal", novalidate = "novalidate" }))
    {
        var subAccount = Model.SubAccountItem;
        @Html.AntiForgeryToken()
        @Html.Hidden("subAccountId", subAccount.SubAccId.ToString())
        <div class="head-title" data-target="#accountDetails">@Resources.AccountDetails</div>
        <div id="accountDetails">
            @{
                Html.RenderPartial("_EditGeneralInfo", subAccount);
                Html.RenderPartial(
                "_Permissions",
                new Tuple<bool, PageAccess>((bool)ViewBag.ShowAccountManagementPermission, subAccount.Permissions));
            }
        </div>
        <div class="head-title" data-target="#tblManagedAccount">@Resources.ManagedAccount (@HtmlHelpers.FormatNumber(Model.NumberOfDownline))</div>
        @Html.Partial("_ManagedAccountTable", Model.ManagedAccountViewModel)
        <div class="list-button text-right">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@Resources.Cancel" />
            <input type="submit" class="btn-submit" value="@Resources.Save" />
        </div>
    }
</div>
@Html.Hidden(nameof(Resources.RequiredNameError), Resources.RequiredNameError)
@Html.Hidden("SuccessMessage", Resources.UpdateSuccessfully)