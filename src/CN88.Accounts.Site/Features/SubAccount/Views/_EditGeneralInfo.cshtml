@using CN88.Accounts.SubAccount.Models
@model SubAccountItem
<div class="general-info account-data">
    <div class="title">@Resources.GeneralData</div>
    <div class="account-data-content">
        <div class="form-group">
            <label class="control-label">@Resources.Username</label>
            <div class="content-control">@Model.UserName</div>
        </div>
        <div class="form-group">
            <label for="name" class="control-label">@Resources.Name</label>
            <div class="content-control">
                <input type="text" class="control" maxlength="50" value="@WebUtility.HtmlDecode(Model.FirstName)" id="name" autocomplete="off" />
            </div>
        </div>
    </div>
</div>