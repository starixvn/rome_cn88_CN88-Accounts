@using CN88.Accounts.Site.Features.Shared.ViewModels
@model CN88.Accounts.Site.Features.ProblemAccount.ViewModels.FilterViewModel
<form class="form-inline filter" role="form" id="report-form">
    @RenderHiddenFeilds()
    @DateRangePicker.Render(Model.DateRangePicker, Resources.DateNotifiedFrom)
    @RenderReviewStatusDropdown(Model.ReviewStatusSelection)
    @if (Model.CustLevel.IsAgentLevel() || Model.CustLevel.IsMemberLevel())
    {
        <div class="form-group">
            <label>@Resources.ResourceManager.GetString(Model.CustLevel.GetDirectUplineLevel().DisplayName)</label>
            <input type="text" id="UplineUsername" name="UplineUsername" class="control upline-username" value="@Model.UplineUsername" />
        </div>
    }
    <div class="form-group">
        <label>@Resources.UsernameOrNameContains</label>
        <input type="text" id="CustName" name="CustName" class="control search-username" value="@Model.CustName" />
    </div>
    <div class="form-group">
        <input type="button" id="btnSubmit" class="btn-submit" value="@Resources.Submit" />
    </div>
</form>
<form class="hide" role="form" id="export-excel-form" action="@Url.Action("Excel", "ProblemAccount")">
    @RenderHiddenFeilds()
    @Html.Hidden("FromDate", Model.DateRangePicker.FromDate)
    @Html.Hidden("ToDate", Model.DateRangePicker.ToDate)
    @Html.Hidden("SelectedReviewStatus", Model.ReviewStatusSelection.SelectedId)
    @if (Model.CustLevel.IsAgentLevel() || Model.CustLevel.IsMemberLevel())
    {
        @Html.Hidden(nameof(Model.UplineUsername), Model.UplineUsername)
    }
    @Html.Hidden(nameof(Model.CustName), Model.CustName)
</form>
@helper RenderHiddenFeilds()
{
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
}
@helper RenderReviewStatusDropdown(SingleSelectionViewModel viewModel)
{
    <div class="form-group">
        <label>@Resources.ReviewStatus</label>
        <select id="dropdown-review-status">
            @foreach (var group in viewModel.Items)
            {
                <option value="@group.Value" @(group.Selected ? " selected=\"selected\"" : string.Empty)>@group.Text</option>
            }
        </select>
        <input type="hidden" name="SelectedReviewStatus" id="SelectedReviewStatus" value="@viewModel.SelectedId" />
    </div>
}
