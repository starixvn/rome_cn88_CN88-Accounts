@using CN88.Accounts.ProblemAccount.Resources
@model CN88.Accounts.Site.Features.ProblemAccount.ViewModels.IndexViewModel
<input type="button" id="btnReview" name="btnReview" class="btn-submit btn-review" value="@ProblemAccountResources.SetToReviewed" />
<table id="tblProblemAccount" class="tbl-style2 table-problem-account">
    <thead>
        <tr>
            <th class="col-no">@SharedResources.No</th>
            <th class="col-username">@ProblemAccountResources.ProblemAccount</th>
            <th class="col-name">@SharedResources.Name</th>
            <th class="col-nickname">@SharedResources.Nickname</th>
            @if (Model.CustLevel.IsMasterLevel())
            {
                <th class="col-numberofaccounts">@ProblemAccountResources.ProblemAgentAccounts <span class="icon-info" data-toggle="tooltip" title="@ProblemAccountResources.ProblemAgentAccountsTooltip" /></th>
            }
            @if (Model.CustLevel.IsAgentLevel())
            {
                <th class="col-numberofaccounts">@ProblemAccountResources.ProblemMemberAccounts <span class="icon-info" data-toggle="tooltip" title="@ProblemAccountResources.ProblemMemberAccountsTooltip" /></th>
            }
            <th class="col-status text-center">@SharedResources.Status</th>
            <th class="col-datenotified">@ProblemAccountResources.DateNotified</th>
            <th class="col-reviewstatus">@ProblemAccountResources.ReviewStatus</th>
            <th class="text-center">
                <input type="checkbox" id="SelectAll" name="SelectAll" value="" />
            </th>
        </tr>
    </thead>
    @if (Model.PageData.Any())
    {
        var index = 1;
        <tbody>
            @foreach (var account in Model.PageData.DataSource)
            {
                <tr>
                    <td>@index</td>
                    <td class="username">
                        @if (Model.CustLevel.IsMemberLevel())
                        {
                            @account.Username
                        }
                        else
                        {
                            <a class="downline-link" href="@Model.BuildDownlineLink(account.Username, Request.Url.Query)">@account.Username</a>
                        }
                    </td>
                    <td>@account.Name</td>
                    <td>@account.Nickname</td>
                    @if (Model.CustLevel.IsMasterLevel() || Model.CustLevel.IsAgentLevel())
                    {
                        <td></td>
                    }
                    <td align="center">
                        <a class="link status-link" data-username="@account.Username" href="@Model.BuildStatusLink(account.CustId,account.Status)">@account.StatusName</a>
                    </td>
                    <td>@account.CreatedDate</td>
                    <td>@account.ReviewStatus</td>
                    <td class="text-center">
                        <input type="checkbox" name="@account.CustId" value="@account.CustId" />
                    </td>
                </tr>
                index++;
            }
        </tbody>
    }
    else
    {
        @NoInformationTable.Render(Model.NumberOfColumns)
    }
</table>
