@using CN88.Accounts.ProblemAccount.Resources
@using CN88.Accounts.Site.Features.Shared.ViewModels
@model CN88.Accounts.Site.Features.ProblemAccount.ViewModels.FilterViewModel
<form class="form-inline filter" role="form" id="report-form">
    @RenderHiddenFeilds()
    @DateRangePicker.Render(Model.DateRangePicker)
    @RenderReviewStatusDropdown(Model.ReviewStatusSelection)
    @if (Model.CustLevel.IsAgentLevel() || Model.CustLevel.IsMemberLevel())
    {
        <div class="form-group">
            <label>@SharedResources.ResourceManager.GetString(Model.CustLevel.GetDirectUplineLevel().DisplayName)</label>
            <input type="text" id="UplineUsername" name="UplineUsername" class="control" value="@Model.UplineUsername" />
        </div>
    }
    <div class="form-group">
        <label>@SharedResources.UsernameOrNameContains</label>
        <input type="text" id="SearchUsername" name="SearchUsername" class="control" value="@Model.SearchUsername" />
    </div>
    <div class="form-group">
        <input type="submit" class="btn-submit" value="@SharedResources.Submit" />
    </div>
    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@SharedResources.ExportToExcel" data-toggle="tooltip" data-placement="bottom"></span>
    </div>
</form>
@helper RenderHiddenFeilds()
{
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
}
@helper RenderReviewStatusDropdown(SingleSelectionViewModel viewModel)
{
    <div class="form-group">
        <label>@ProblemAccountResources.ReviewStatus</label>
        <select id="dropdown-review-status">
            @foreach (var group in viewModel.Items)
            {
                <option value="@group.Value" @(group.Selected ? " selected=\"selected\"" : string.Empty)>@group.Text</option>
            }
        </select>
        <input type="hidden" name="" id="SelectedReviewStatus" value="@viewModel.SelectedId" />
    </div>
}
