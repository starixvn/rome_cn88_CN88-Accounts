@using CN88.Accounts.Shared.Resources
@using CN88.Accounts.Site.Features.Shared.ViewModels
@helper Render(PagerViewModel model)
{
    if (model?.TotalRecords > 0)
    {
        <div id="pager"
             data-labelpage="@SharedResources.Page"
             data-labelof="@SharedResources.of"
             data-labeldisplayitems="@SharedResources.Pager_DisplayItems"
             data-pageindex="@model.PageIndex"
             data-pagesize="@model.PageSize"
             data-totalrecords="@model.TotalRecords">
        </div>
    }
}
